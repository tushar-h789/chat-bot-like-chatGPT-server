meta {
  name: Login Wrong Password
  type: http
  seq: 6
}

post {
  url: {{BASE_URL}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
  X-CSRF-Token: {{CSRF_TOKEN}}
}

body:json {
  {
    "email": "{{EMAIL}}",
    "password": "incorrect-password-1"
  }
}

docs {
  # POST /api/v1/auth/login

  Uses the registered email and a wrong password. An unknown email returns the same body.

  ## Request body

  ```json
  {
    "email": "bruno-1710000000000@example.com",
    "password": "incorrect-password-1"
  }
  ```

  ## Response `401`

  ```json
  {
    "error": {
      "code": "invalid_credentials",
      "message": "Invalid email or password."
    }
  }
  ```
}

tests {
  test("rejects the password", function () {
    expect(res.getStatus()).to.equal(401);
    const body = res.getBody();
    expect(body.error.code).to.equal("invalid_credentials");
    expect(body.error.message).to.equal("Invalid email or password.");
    expect(JSON.stringify(body)).to.not.include("incorrect-password-1");
  });
}

assert {
  res.status: eq 401
}

example {
  name: 401 Unauthorized
  description: Wrong password

  request: {
    url: {{BASE_URL}}/api/v1/auth/login
    method: POST
    mode: json
    headers: {
      Accept: application/json
      Content-Type: application/json
      X-CSRF-Token: {{CSRF_TOKEN}}
    }
    body:json: {
      {
        "email": "{{EMAIL}}",
        "password": "incorrect-password-1"
      }
    }
  }

  response: {
    headers: {
      content-type: application/json
    }

    status: {
      code: 401
      text: Unauthorized
    }

    body: {
      type: json
      content: '''
        {
          "error": {
            "code": "invalid_credentials",
            "message": "Invalid email or password."
          }
        }
      '''
    }
  }
}

settings {
  encodeUrl: true
  timeout: 25000
}
