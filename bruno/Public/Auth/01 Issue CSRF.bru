meta {
  name: Issue CSRF
  type: http
  seq: 1
}

get {
  url: {{BASE_URL}}/api/v1/auth/csrf
  body: none
  auth: none
}

headers {
  Accept: application/json
}

docs {
  # GET /api/v1/auth/csrf

  Issues the double-submit CSRF token. Run this before Register, Login, or Logout.

  The same value is returned in the body and stored in the `csrf_token` cookie. The post-response script saves it as `CSRF_TOKEN`.

  ## Response `200`

  ```json
  { "csrf_token": "url-safe-random-token" }
  ```
}

script:post-response {
  const body = res.getBody();
  if (res.getStatus() === 200 && body.csrf_token) {
    bru.setEnvVar("CSRF_TOKEN", body.csrf_token);
    bru.setVar("CSRF_TOKEN", body.csrf_token);
  }
}

tests {
  test("returns a csrf token", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().csrf_token).to.be.a("string");
    expect(res.getBody().csrf_token.length).to.be.greaterThan(20);
  });
}

assert {
  res.status: eq 200
}

example {
  name: 200 OK
  description: Returns a CSRF token

  request: {
    url: {{BASE_URL}}/api/v1/auth/csrf
    method: GET
    headers: {
      Accept: application/json
    }
  }

  response: {
    headers: {
      content-type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        { "csrf_token": "url-safe-random-token" }
      '''
    }
  }
}

settings {
  encodeUrl: true
  timeout: 25000
}
