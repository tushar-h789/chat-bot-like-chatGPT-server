meta {
  name: Register Without CSRF
  type: http
  seq: 4
}

post {
  url: {{BASE_URL}}/api/v1/auth/register
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "email": "csrf-missing@example.com",
    "password": "{{PASSWORD}}"
  }
}

docs {
  # POST /api/v1/auth/register

  Same body as Register, without `X-CSRF-Token`. Run **Issue CSRF** first so the cookie exists.

  ## Response `403`

  ```json
  {
    "error": {
      "code": "csrf_failed",
      "message": "CSRF token is missing or invalid."
    }
  }
  ```
}

tests {
  test("rejects a missing csrf token", function () {
    expect(res.getStatus()).to.equal(403);
    expect(res.getBody().error.code).to.equal("csrf_failed");
    expect(res.getBody().error.message).to.equal("CSRF token is missing or invalid.");
  });
}

assert {
  res.status: eq 403
}

example {
  name: 403 Forbidden
  description: Missing CSRF token

  request: {
    url: {{BASE_URL}}/api/v1/auth/register
    method: POST
    mode: json
    headers: {
      Accept: application/json
      Content-Type: application/json
    }
    body:json: {
      {
        "email": "csrf-missing@example.com",
        "password": "{{PASSWORD}}"
      }
    }
  }

  response: {
    headers: {
      content-type: application/json
    }

    status: {
      code: 403
      text: Forbidden
    }

    body: {
      type: json
      content: '''
        {
          "error": {
            "code": "csrf_failed",
            "message": "CSRF token is missing or invalid."
          }
        }
      '''
    }
  }
}

settings {
  encodeUrl: true
  timeout: 25000
}
