meta {
  name: Login
  type: http
  seq: 3
}

post {
  url: {{BASE_URL}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
  X-CSRF-Token: {{CSRF_TOKEN}}
}

body:json {
  {
    "email": "{{EMAIL}}",
    "password": "{{PASSWORD}}"
  }
}

docs {
  # POST /api/v1/auth/login

  Starts a new session for an existing account. Run **Register** first so `EMAIL` is set.

  ## Request body

  ```json
  {
    "email": "bruno-1710000000000@example.com",
    "password": "correct-horse-battery"
  }
  ```

  ## Response `200`

  ```json
  {
    "id": "6f1c1c4e-8a0d-4f0a-9d4a-1e6d0c2b9a11",
    "email": "bruno-1710000000000@example.com",
    "created_at": "2026-10-06T15:40:00.000000Z"
  }
  ```

  Also sets a new HttpOnly `session` cookie.

  ## Errors

  `401` `invalid_credentials` — unknown email and wrong password return the same message.
}

tests {
  test("starts a session", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.email).to.equal(bru.getEnvVar("EMAIL"));
    expect(body.id).to.equal(bru.getEnvVar("USER_ID"));
    expect(JSON.stringify(body)).to.not.include("correct-horse-battery");
  });
}

assert {
  res.status: eq 200
}

example {
  name: 200 OK
  description: Starts a session

  request: {
    url: {{BASE_URL}}/api/v1/auth/login
    method: POST
    mode: json
    headers: {
      Accept: application/json
      Content-Type: application/json
      X-CSRF-Token: {{CSRF_TOKEN}}
    }
    body:json: {
      {
        "email": "{{EMAIL}}",
        "password": "{{PASSWORD}}"
      }
    }
  }

  response: {
    headers: {
      content-type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "id": "6f1c1c4e-8a0d-4f0a-9d4a-1e6d0c2b9a11",
          "email": "bruno-1710000000000@example.com",
          "created_at": "2026-10-06T15:40:00.000000Z"
        }
      '''
    }
  }
}

settings {
  encodeUrl: true
  timeout: 25000
}
