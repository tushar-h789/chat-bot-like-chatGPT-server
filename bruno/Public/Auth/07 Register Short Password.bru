meta {
  name: Register Short Password
  type: http
  seq: 7
}

post {
  url: {{BASE_URL}}/api/v1/auth/register
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
  X-CSRF-Token: {{CSRF_TOKEN}}
}

body:json {
  {
    "email": "short-password@example.com",
    "password": "short-pass"
  }
}

docs {
  # POST /api/v1/auth/register

  Password is shorter than 12 characters. The response does not echo it.

  ## Request body

  ```json
  {
    "email": "short-password@example.com",
    "password": "short-pass"
  }
  ```

  ## Response `422`

  ```json
  {
    "error": {
      "code": "validation_error",
      "message": "Request validation failed."
    }
  }
  ```
}

tests {
  test("rejects a short password", function () {
    expect(res.getStatus()).to.equal(422);
    const body = res.getBody();
    expect(body.error.code).to.equal("validation_error");
    expect(body.error.message).to.equal("Request validation failed.");
    expect(JSON.stringify(body)).to.not.include("short-pass");
  });
}

assert {
  res.status: eq 422
}

example {
  name: 422 Unprocessable Content
  description: Password is too short

  request: {
    url: {{BASE_URL}}/api/v1/auth/register
    method: POST
    mode: json
    headers: {
      Accept: application/json
      Content-Type: application/json
      X-CSRF-Token: {{CSRF_TOKEN}}
    }
    body:json: {
      {
        "email": "short-password@example.com",
        "password": "short-pass"
      }
    }
  }

  response: {
    headers: {
      content-type: application/json
    }

    status: {
      code: 422
      text: Unprocessable Content
    }

    body: {
      type: json
      content: '''
        {
          "error": {
            "code": "validation_error",
            "message": "Request validation failed."
          }
        }
      '''
    }
  }
}

settings {
  encodeUrl: true
  timeout: 25000
}
