# Copy to .env and fill in local values. Never commit .env.

# development, test, or production
ENVIRONMENT=development

# PostgreSQL. Matches the local Compose defaults.
DATABASE_URL=postgresql+asyncpg://chatbot:chatbot@localhost:5432/chatbot

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# Used later to sign the CSRF cookie. Generate a long random value locally.
SESSION_SECRET=

# gemini or openai. The default is gemini.
AI_PROVIDER=gemini

# Gemini Developer API. Put the key only in backend/.env. Do not paste it into chat.
# Suggested free-tier text model with streaming, from the Gemini API docs:
# https://ai.google.dev/gemini-api/docs/models
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Seconds to wait for one Gemini call. Default 60. Maximum 300.
GEMINI_TIMEOUT_SECONDS=60

# OpenAI. Put the key only in backend/.env. Do not paste it into chat.
OPENAI_API_KEY=
OPENAI_MODEL=
# Seconds to wait for one Responses API call. Default 60. Maximum 300.
OPENAI_TIMEOUT_SECONDS=60

# Maximum characters stored in one message. Default 16000. Absolute cap 100000.
MAX_MESSAGE_CHARS=16000

# Largest request body, in bytes. Default 6291456, enough for one 5 MB upload.
MAX_BODY_BYTES=6291456

# Largest single upload, in bytes. Default 5242880.
MAX_UPLOAD_BYTES=5242880

# Directory for uploaded files. Default backend/var/uploads.
# UPLOAD_DIR=

# Login and register attempts per client address per minute. Default 20.
RATE_LIMIT_AUTH_PER_MINUTE=20

# Chat sends per signed-in user per minute. Default 30.
RATE_LIMIT_CHAT_PER_MINUTE=30

# Tokens from finished replies per user since 00:00 UTC. Default 100000.
# Set 0 to turn the daily cap off.
USAGE_LIMIT_TOKENS_PER_DAY=100000

# Optional USD per 1,000,000 tokens, from the provider pricing page.
# Leave empty to track tokens without a dollar amount.
# GEMINI_INPUT_USD_PER_MILLION=
# GEMINI_OUTPUT_USD_PER_MILLION=
# OPENAI_INPUT_USD_PER_MILLION=
# OPENAI_OUTPUT_USD_PER_MILLION=
